# ===== LLM (any OpenAI-compatible API) =====
# DeepSeek example. High consumption — try simulations with < 40 rounds first.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-flash

# ===== Knowledge graph memory: Graphiti + Neo4j (self-hosted, replaces Zep Cloud) =====
# docker compose starts Neo4j for you; for source deployment run e.g.
#   docker run -d -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/<password> neo4j:5.26
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_please

# Optional: separate model for graph extraction (defaults to LLM_MODEL_NAME).
# GRAPH_LLM_MODEL_NAME=deepseek-flash
# 'json_object' works with DeepSeek and most providers; 'json_schema' needs native structured outputs.
# GRAPH_LLM_STRUCTURED_OUTPUT=json_object
# Max concurrent LLM calls during graph extraction (lower it if you hit rate limits).
# GRAPH_MAX_COROUTINES=8
# Document chunks are extracted in bulk slices of this size (fast). Set 1 for
# sequential extraction: ~3x slower, but finds noticeably more relations.
# GRAPH_BULK_SLICE_SIZE=10

# ===== Embeddings =====
# DeepSeek has no embeddings API. Leave EMBEDDING_API_KEY empty to use a local
# multilingual model (downloaded on first use, runs on CPU), or point it at any
# OpenAI-compatible embeddings endpoint. Changing the model later requires
# rebuilding existing graphs.
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL_NAME=text-embedding-3-small

# ===== Boost LLM (optional) =====
# If you don't use a boost LLM, leave these lines out of .env entirely.
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
